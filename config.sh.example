#!/usr/bin/env bash
# shellcheck disable=SC2034

# agent-sandbox config — copy to ~/.agent-sandbox/config.sh and edit.
#
# This file is sourced by the `agent` launcher, so anything bash supports (comments,
# $HOME expansion, $(command substitution), conditionals) works.

# Extra Debian packages baked into the image. Applied on `agent update`.
APT_PACKAGES=(
    # tmux
    # vim
)

# Extra npm packages installed globally. Applied on `agent update`.
NPM_PACKAGES=(
    # corepack
)

# Extra mounts applied to every `agent` run. Docker -v syntax:
#   SOURCE:TARGET[:ro]
MOUNTS=(
    # "$HOME/Documents/notes:/home/agent/notes:ro"
    # "$HOME/.aws:/home/agent/.aws:ro"
)

# Extra raw arguments passed to docker run on every `agent` run.
DOCKER_ARGS=(
    # --memory=4g
    # --network=host
    # --device=/dev/ttyUSB0
)

# Optional pre-run hook: a function called on the HOST just before `docker run`.
# Receives <command> [args...] as arguments. Use it for any host-side setup.
#
# pre_run() {
#     patch_localhost \
#         "$SANDBOX_HOME/.pi/agent/models.json" \
#         "$SANDBOX_HOME/.config/opencode/opencode.json"
# }
