#!/usr/bin/env bash

set -euo pipefail

SANDBOX_ROOT="$HOME/.agent-sandbox"
SANDBOX_HOME="$SANDBOX_ROOT/home"
BASE_IMAGE="local/agent-sandbox:base"
AGENT_IMAGE="local/agent-sandbox:latest"

CONFIG_FILE="$SANDBOX_ROOT/config.sh"

PROJECT_DIR="$(pwd)"
PROJECT_NAME="$(basename "$PROJECT_DIR" | tr -cd '[:alnum:]_.-')"

# Arrays the user can set in config.sh; default to empty so `set -u` is happy.
APT_PACKAGES=()
NPM_PACKAGES=()
MOUNTS=()
DOCKER_ARGS=()

if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

for mount in "${MOUNTS[@]+"${MOUNTS[@]}"}"; do
    DOCKER_ARGS+=(--volume "$mount")
done

# Bare-digit specs (e.g. "8000") map host:container 1-to-1, overriding docker's default
# of picking a random host port. Anything with a ":" or other characters passes through
# unchanged.
expand_publish_spec() {
    if [[ "$1" =~ ^[0-9]+$ ]]; then
        printf '%s:%s' "$1" "$1"
    else
        printf '%s' "$1"
    fi
}

while [[ $# -gt 0 ]]; do
    case "$1" in
    -D | --docker-arg)
        if [[ -z "${2:-}" ]]; then
            echo "agent: $1 requires an argument (e.g. -D --memory=4g)" >&2
            exit 1
        fi
        DOCKER_ARGS+=("$2")
        shift 2
        ;;

    -D=* | --docker-arg=*)
        DOCKER_ARGS+=("${1#*=}")
        shift
        ;;

    -p | --publish)
        if [[ -z "${2:-}" ]]; then
            echo "agent: $1 requires an argument (e.g. -p 3000 or -p 127.0.0.1:3000:3000)" >&2
            exit 1
        fi
        DOCKER_ARGS+=(--publish "$(expand_publish_spec "$2")")
        shift 2
        ;;

    -p=* | --publish=*)
        DOCKER_ARGS+=(--publish "$(expand_publish_spec "${1#*=}")")
        shift
        ;;

    -e | --env)
        if [[ -z "${2:-}" ]]; then
            echo "agent: $1 requires an argument (e.g. -e DEBUG or -e NODE_ENV=development)" >&2
            exit 1
        fi
        DOCKER_ARGS+=(--env "$2")
        shift 2
        ;;

    -e=* | --env=*)
        DOCKER_ARGS+=(--env "${1#*=}")
        shift
        ;;

    -v | --volume)
        if [[ -z "${2:-}" ]]; then
            echo "agent: $1 requires an argument (e.g. -v /host:/container)" >&2
            exit 1
        fi
        DOCKER_ARGS+=(--volume "$2")
        shift 2
        ;;

    -v=* | --volume=*)
        DOCKER_ARGS+=(--volume "${1#*=}")
        shift
        ;;

    *)
        break
        ;;
    esac
done

COMMAND="${1:-bash}"
shift || true

# Let `agent bash <cmd> [args...]` run <cmd> directly inside the container, instead of
# bash treating <cmd> as a script file. `exec "$@"` preserves argv boundaries so quoting
# survives.
if [[ "$COMMAND" == "bash" && $# -gt 0 && "$1" != "-"* ]]; then
    set -- -c 'exec "$@"' bash "$@"
fi

usage() {
    cat <<EOF
agent — Run AI coding agents in a sandboxed Docker container

Usage:
  agent [-p PORT]... [-e ENV]... [-D ARG]... [command] [args...]

Options:
  -p, --publish SPEC    Publish a container port (repeatable). A bare port
                        number maps host:container 1-to-1; full docker -p
                        syntax also works:
                          -p 3000                  # host 3000 -> container 3000
                          -p 8080:80               # host 8080 -> container 80
                          -p 127.0.0.1:3000:3000   # bind to loopback only
  -e, --env SPEC        Set an environment variable (repeatable). Supports
                        Docker env syntax:
                          -e DEBUG                 # pass host value through
                          -e NODE_ENV=development  # set explicit value
  -v, --volume SPEC     Mount a host path into the container (repeatable).
                        Uses docker -v syntax:
                          -v /host/path:/container/path
                          -v /host/path:/container/path:ro
  -D, --docker-arg ARG  Pass a raw argument to docker run (repeatable).
                        Use for flags not covered above:
                          -D --memory=4g
                          -D --network=host
                          -D --device=/dev/ttyUSB0

Commands:
  bash      [args...]   Open an interactive bash shell (default), forwarding args
  claude    [args...]   Run Claude Code, forwarding args
  codex     [args...]   Run Codex, forwarding args
  copilot   [args...]   Run Copilot, forwarding args
  cursor    [args...]   Run Cursor Agent, forwarding args
  opencode  [args...]   Run OpenCode, forwarding args
  pi        [args...]   Run Pi, forwarding args
  versions              Print versions of the bundled tools
  update                Pull latest and rebuild the sandbox image from $SANDBOX_ROOT
  help, -h, --help      Show this message

Environment:
  Project mount:  \$PWD -> /workspace
  Home mount:     $SANDBOX_HOME -> /home/agent
  Config file:    $CONFIG_FILE (optional; see config.sh.example)
  Image:          $AGENT_IMAGE

Examples:
  agent                            # Open a shell
  agent claude                     # Start Claude Code
  agent claude -p "explain repo"   # One-shot Claude prompt
  agent -p 5173 bash               # Expose a dev server port to the host
  agent -e NODE_ENV=development    # Open a shell with NODE_ENV set
  agent versions                   # Show tool versions
  agent update                     # Rebuild the image
EOF
}

mkdir -p "$SANDBOX_HOME"
chmod 700 "$SANDBOX_HOME"

case "$COMMAND" in
bash | claude | opencode | pi | codex | cursor | copilot)
    ;;

update)
    git -C "$SANDBOX_ROOT" pull --ff-only
    docker build --pull --no-cache -t "$BASE_IMAGE" "$SANDBOX_ROOT"

    if [[ ${#APT_PACKAGES[@]} -eq 0 && ${#NPM_PACKAGES[@]} -eq 0 ]]; then
        docker tag "$BASE_IMAGE" "$AGENT_IMAGE"
        exit 0
    fi

    OVERLAY_DIR="$(mktemp -d "${TMPDIR:-/tmp}/agent-sandbox.XXXXXXXX")"
    trap 'rm -rf "$OVERLAY_DIR"' EXIT

    OVERLAY_DOCKERFILE="$OVERLAY_DIR/Dockerfile"
    {
        echo "FROM $BASE_IMAGE"
        echo
        echo "USER root"
        if [[ ${#APT_PACKAGES[@]} -gt 0 ]]; then
            echo
            echo "RUN apt-get update \\"
            echo "    && apt-get install -y --no-install-recommends \\"
            echo "        ${APT_PACKAGES[*]} \\"
            echo "    && rm -rf /var/lib/apt/lists/*"
        fi
        if [[ ${#NPM_PACKAGES[@]} -gt 0 ]]; then
            echo
            echo "RUN npm install -g ${NPM_PACKAGES[*]}"
        fi
    } > "$OVERLAY_DOCKERFILE"

    docker build --no-cache -t "$AGENT_IMAGE" -f "$OVERLAY_DOCKERFILE" "$OVERLAY_DIR"
    exit 0
    ;;

versions)
    COMMAND=bash
    # shellcheck disable=SC2016
    set -- -c '
		echo "node:     $(node --version)"
		echo "npm:      $(npm --version)"
		echo
		echo "claude:   $(claude --version 2>/dev/null || echo unavailable)"
		echo "opencode: $(opencode --version 2>/dev/null || echo unavailable)"
		echo "pi:       $(pi --version 2>/dev/null || echo unavailable)"
		echo "codex:    $(codex --version 2>/dev/null || echo unavailable)"
		echo "copilot:  $(copilot --version 2>/dev/null || echo unavailable)"
		echo "cursor:   $(cursor --version 2>/dev/null || echo unavailable)"
	'
    ;;

help | -h | --help)
    usage
    exit 0
    ;;

*)
    echo "agent: unknown command '$COMMAND'" >&2
    echo >&2
    usage >&2
    exit 1
    ;;

esac

docker run --rm -it \
    --name "agent-${PROJECT_NAME}-$$" \
    --workdir /workspace \
    --user "$(id -u):$(id -g)" \
    --env HOME=/home/agent \
    --env AGENT_PROJECT_NAME="$PROJECT_NAME" \
    --env TERM \
    --env COLORTERM \
    --env TERM_PROGRAM \
    --env TERM_PROGRAM_VERSION \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --volume "$PROJECT_DIR:/workspace" \
    --volume "$SANDBOX_HOME:/home/agent" \
    ${DOCKER_ARGS[@]+"${DOCKER_ARGS[@]}"} \
    "$AGENT_IMAGE" \
    "$COMMAND" "$@"
