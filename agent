#!/usr/bin/env bash

set -euo pipefail

PROJECT_DIR="$(pwd)"
PROJECT_NAME="$(basename "$PROJECT_DIR" | tr -cd '[:alnum:]_.-')"

SANDBOX_ROOT="$HOME/.agent-sandbox"
SANDBOX_HOME="$SANDBOX_ROOT/home"
IMAGE="local/agent-sandbox:latest"

# Bare-digit specs (e.g. "8000") map host:container 1-to-1, overriding docker's default
# of picking a random host port. Anything with a ":" or other characters passes through
# unchanged.
expand_publish_spec() {
    if [[ "$1" =~ ^[0-9]+$ ]]; then
        printf '%s:%s' "$1" "$1"
    else
        printf '%s' "$1"
    fi
}

PUBLISH_ARGS=()
ENV_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
    -p | --publish)
        if [[ -z "${2:-}" ]]; then
            echo "agent: $1 requires an argument (e.g. -p 3000 or -p 127.0.0.1:3000:3000)" >&2
            exit 1
        fi
        PUBLISH_ARGS+=(--publish "$(expand_publish_spec "$2")")
        shift 2
        ;;

    -p=* | --publish=*)
        PUBLISH_ARGS+=(--publish "$(expand_publish_spec "${1#*=}")")
        shift
        ;;

    -e | --env)
        if [[ -z "${2:-}" ]]; then
            echo "agent: $1 requires an argument (e.g. -e DEBUG or -e NODE_ENV=development)" >&2
            exit 1
        fi
        ENV_ARGS+=(--env "$2")
        shift 2
        ;;

    -e=* | --env=*)
        ENV_ARGS+=(--env "${1#*=}")
        shift
        ;;

    *)
        break
        ;;
    esac
done

AGENT="${1:-bash}"
shift || true

# Let `agent bash <cmd> [args...]` run <cmd> directly inside the container, instead of
# bash treating <cmd> as a script file. `exec "$@"` preserves argv boundaries so quoting
# survives.
if [[ "$AGENT" == "bash" && $# -gt 0 && "$1" != "-"* ]]; then
    set -- -c 'exec "$@"' bash "$@"
fi

usage() {
    cat <<EOF
agent — Run AI coding agents in a sandboxed Docker container

Usage:
  agent [-p PORT]... [-e ENV]... [command] [args...]

Options:
  -p, --publish SPEC    Publish a container port (repeatable). A bare port
                        number maps host:container 1-to-1; full docker -p
                        syntax also works:
                          -p 3000                  # host 3000 -> container 3000
                          -p 8080:80               # host 8080 -> container 80
                          -p 127.0.0.1:3000:3000   # bind to loopback only
  -e, --env SPEC        Set an environment variable (repeatable). Supports
                        Docker env syntax:
                          -e DEBUG                 # pass host value through
                          -e NODE_ENV=development  # set explicit value

Commands:
  bash      [args...]   Open an interactive bash shell (default), forwarding args
  claude    [args...]   Run Claude Code, forwarding args
  opencode  [args...]   Run opencode, forwarding args
  pi        [args...]   Run pi, forwarding args
  codex     [args...]   Run codex, forwarding args
  versions              Print versions of the bundled tools
  update                Pull latest and rebuild the sandbox image from $SANDBOX_ROOT
  help, -h, --help      Show this message

Environment:
  Project mount:  \$PWD -> /workspace
  Home mount:     $SANDBOX_HOME -> /home/agent
  Image:          $IMAGE

Examples:
  agent                            # Open a shell
  agent claude                     # Start Claude Code
  agent claude -p "explain repo"   # One-shot Claude prompt
  agent -p 5173 bash               # Expose a dev server port to the host
  agent -e NODE_ENV=development    # Open a shell with NODE_ENV set
  agent versions                   # Show tool versions
  agent update                     # Rebuild the image
EOF
}

mkdir -p "$SANDBOX_HOME"
chmod 700 "$SANDBOX_HOME"

case "$AGENT" in
bash | claude | opencode | pi | codex)
    ;;

update)
    git -C "$SANDBOX_ROOT" pull --ff-only
    docker build --pull --no-cache -t "$IMAGE" "$SANDBOX_ROOT"
    exit 0
    ;;

versions)
    AGENT=bash
    # shellcheck disable=SC2016
    set -- -c '
		echo "node:     $(node --version)"
		echo "npm:      $(npm --version)"
		echo
		echo "claude:   $(claude --version 2>/dev/null || echo unavailable)"
		echo "opencode: $(opencode --version 2>/dev/null || echo unavailable)"
		echo "pi:       $(pi --version 2>/dev/null || echo unavailable)"
		echo "codex:    $(codex --version 2>/dev/null || echo unavailable)"
	'
    ;;

help | -h | --help)
    usage
    exit 0
    ;;

*)
    echo "agent: unknown command '$AGENT'" >&2
    echo >&2
    usage >&2
    exit 1
    ;;

esac

docker run --rm -it \
    --name "agent-${PROJECT_NAME}-$$" \
    --workdir /workspace \
    --user "$(id -u):$(id -g)" \
    --env HOME=/home/agent \
    --env TERM \
    --env COLORTERM \
    --env TERM_PROGRAM \
    --env TERM_PROGRAM_VERSION \
    ${ENV_ARGS[@]+"${ENV_ARGS[@]}"} \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --volume "$PROJECT_DIR:/workspace" \
    --volume "$SANDBOX_HOME:/home/agent" \
    ${PUBLISH_ARGS[@]+"${PUBLISH_ARGS[@]}"} \
    "$IMAGE" \
    "$AGENT" "$@"
