#!/usr/bin/env bash

set -euo pipefail

AGENT="${1:-shell}"
shift || true

PROJECT_DIR="$(pwd)"
PROJECT_NAME="$(basename "$PROJECT_DIR" | tr -cd '[:alnum:]_.-')"

SANDBOX_ROOT="$HOME/.agent-sandbox"
SANDBOX_HOME="$SANDBOX_ROOT/home"
IMAGE="local/agent-sandbox:latest"

usage() {
  cat <<EOF
agent — Run AI coding agents in a sandboxed Docker container

Usage:
  agent [command] [args...]

Commands:
  shell                 Open an interactive bash shell in the sandbox (default)
  claude    [args...]   Run Claude Code, forwarding args
  opencode  [args...]   Run opencode, forwarding args
  pi        [args...]   Run pi, forwarding args
  codex     [args...]   Run codex, forwarding args
  versions              Print versions of the bundled tools
  update                Rebuild the sandbox image from $SANDBOX_ROOT
  help, -h, --help      Show this message

Environment:
  Project mount:  \$PWD            -> /workspace
  Home mount:     $SANDBOX_HOME -> /home/agent
  Image:          $IMAGE

Examples:
  agent                          # Open a shell
  agent claude                   # Start Claude Code
  agent claude -p "explain repo" # One-shot Claude prompt
  agent versions                 # Show tool versions
  agent update                   # Rebuild the image
EOF
}

mkdir -p "$SANDBOX_HOME"
chmod 700 "$SANDBOX_HOME"

case "$AGENT" in
shell)
  CMD="bash"
  ;;

claude)
  CMD="claude $*"
  ;;

opencode)
  CMD="opencode $*"
  ;;

pi)
  CMD="pi $*"
  ;;

codex)
  CMD="codex $*"
  ;;

update)
  docker build --pull --no-cache -t "$IMAGE" "$SANDBOX_ROOT"
  exit 0
  ;;

versions)
  docker run --rm -it \
    --env HOME=/home/agent \
    --volume "$SANDBOX_HOME:/home/agent" \
    "$IMAGE" \
    bash -lc '
      echo "node:     $(node --version)"
      echo "npm:      $(npm --version)"
      echo
      echo "claude:   $(claude --version 2>/dev/null || echo unavailable)"
      echo "opencode: $(opencode --version 2>/dev/null || echo unavailable)"
      echo "pi:       $(pi --version 2>/dev/null || echo unavailable)"
      echo "codex:    $(codex --version 2>/dev/null || echo unavailable)"
    '
  exit 0
  ;;

help | -h | --help)
  usage
  exit 0
  ;;

*)
  echo "agent: unknown command '$AGENT'" >&2
  echo >&2
  usage >&2
  exit 1
  ;;

esac

docker run --rm -it \
  --name "agent-${PROJECT_NAME}" \
  --workdir /workspace \
  --user "$(id -u):$(id -g)" \
  --env HOME=/home/agent \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --volume "$PROJECT_DIR:/workspace" \
  --volume "$SANDBOX_HOME:/home/agent" \
  "$IMAGE" \
  bash -lc "$CMD"
